# Domain pointing to 147.15.92.45 (A record) - Caddy gets a Let's Encrypt cert
DOMAIN=agent-history.cslog.com.br

# Bearer token required by all endpoints except /health
API_TOKEN=change-me-long-random

# OCI MySQL (private VCN address, reachable from this VM)
MYSQL_HOST=10.0.0.36
MYSQL_PORT=3306
MYSQL_USER=agent_history
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=agent_history

# LLM summarizer (OpenAI-compatible)
SUMMARY_BASE_URL=https://cliproxyapi.cslog.com.br/v1
SUMMARY_API_KEY=
SUMMARY_MODEL=kimi-k3
SUMMARY_BATCH=10
