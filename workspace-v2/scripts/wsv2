#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONTROL_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/workspace-v2/control-host.env"
if [[ -f "$CONTROL_ENV" && -z "${WSV2_SELF_HOST:-}" && -z "${WSV2_CONFIG_PATH:-}" ]]; then
  # shellcheck disable=SC1090
  source "$CONTROL_ENV"
fi
export PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m wsv2.cli "$@"
