[Unit]
Description=AI Workflow Codex app-server control service
After=network-online.target codex-app-server.service
Wants=network-online.target codex-app-server.service

[Service]
Type=simple
WorkingDirectory=%h/ai-workflow/codex-control-service
Environment=CODEX_CONTROL_CODEX_BIN=%h/.local/bin/codex
Environment=CODEX_CONTROL_DEFAULT_CWD=%h/ai-workflow
Environment=CODEX_CONTROL_ALLOWED_ROOTS=%h
Environment=CODEX_CONTROL_SOCKET=%h/ai-workflow/runtime/codex-control/control.sock
Environment=CODEX_CONTROL_APP_SERVER_URL=ws://192.168.160.1:4500
Environment=CODEX_CONTROL_APP_SERVER_TOKEN_FILE=%h/ai-workflow/runtime/codex-remote/app-server-token
Environment=CODEX_CONTROL_APP_SERVER_READY_URL=http://192.168.160.1:4500/readyz
ExecStart=%h/ai-workflow/codex-control-service/deploy/run-user-service.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
MemoryHigh=256M

[Install]
WantedBy=default.target
