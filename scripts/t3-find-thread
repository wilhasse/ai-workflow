#!/usr/bin/env bash

set -euo pipefail

readonly DB_PATH="/home/cslog/.t3/userdata/state.sqlite"
readonly ENVIRONMENT_ID_PATH="/home/cslog/.t3/userdata/environment-id"
readonly DEFAULT_LIMIT=20

usage() {
  cat <<'EOF'
Usage: t3-find-thread [--json] [--limit N] [--] TEXT...

Find T3 Code threads whose finalized user prompts contain TEXT.

Options:
  --json     Print a versioned JSON response (no matches is successful)
  --limit N  Return at most N threads (default: 20; range: 1..200)
  --help     Show this help
EOF
}

fail() {
  printf 't3-find-thread: %s\n' "$1" >&2
  exit 2
}

sanitize_one_line() {
  local value=$1
  value=${value//$'\r'/ }
  value=${value//$'\n'/ }
  value=${value//$'\t'/ }
  printf '%s' "$value"
}

limit=$DEFAULT_LIMIT
json_output=false

while (($# > 0)); do
  case $1 in
    --help)
      usage
      exit 0
      ;;
    --limit)
      (($# >= 2)) || fail '--limit requires a value'
      limit=$2
      shift 2
      ;;
    --json)
      json_output=true
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      fail "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

(($# > 0)) || {
  usage >&2
  exit 2
}

[[ $limit =~ ^[0-9]+$ ]] || fail '--limit must be an integer from 1 to 200'
leading_zeros=${limit%%[!0]*}
normalized_limit=${limit#"$leading_zeros"}
[[ -n $normalized_limit ]] || normalized_limit=0
(( ${#normalized_limit} <= 3 )) || fail '--limit must be an integer from 1 to 200'
limit=$((10#$normalized_limit))
((limit >= 1 && limit <= 200)) || fail '--limit must be an integer from 1 to 200'

search_text=$*
[[ -n $search_text ]] || fail 'TEXT must not be empty'

command -v sqlite3 >/dev/null 2>&1 || fail 'sqlite3 is required'
command -v od >/dev/null 2>&1 || fail 'od is required'
command -v tr >/dev/null 2>&1 || fail 'tr is required'
[[ -r $DB_PATH ]] || fail "cannot read database: $DB_PATH"
[[ -r $ENVIRONMENT_ID_PATH ]] || fail "cannot read environment ID: $ENVIRONMENT_ID_PATH"

environment_id=$(tr -d '\r\n' < "$ENVIRONMENT_ID_PATH") || fail 'could not read environment ID'
environment_id=$(sanitize_one_line "$environment_id")
[[ -n $environment_id ]] || fail "environment ID is empty: $ENVIRONMENT_ID_PATH"

search_hex=$(printf '%s' "$search_text" | LC_ALL=C od -An -v -tx1 | tr -d ' \n') ||
  fail 'could not encode search text'
[[ $search_hex =~ ^([0-9a-f]{2})+$ ]] || fail 'search text could not be encoded as lowercase UTF-8 hex'
environment_hex=$(printf '%s' "$environment_id" | LC_ALL=C od -An -v -tx1 | tr -d ' \n') ||
  fail 'could not encode environment ID'
[[ $environment_hex =~ ^([0-9a-f]{2})+$ ]] || fail 'environment ID could not be encoded safely'

read -r -d '' query_ctes <<SQL || true
WITH
params(needle) AS (
  VALUES (CAST(X'$search_hex' AS TEXT))
),
matches AS (
  SELECT
    m.thread_id,
    m.message_id,
    m.text AS message_text,
    m.created_at AS match_created_at,
    instr(lower(m.text), lower(params.needle)) AS match_position,
    length(params.needle) AS needle_length,
    t.title,
    t.archived_at,
    p.workspace_root,
    r.provider_name,
    r.provider_instance_id,
    CASE
      WHEN lower(COALESCE(r.provider_name, '')) = 'codex'
        AND json_valid(r.resume_cursor_json)
      THEN json_extract(r.resume_cursor_json, '$.threadId')
      ELSE NULL
    END AS codex_id
  FROM projection_thread_messages AS m
  JOIN projection_threads AS t ON t.thread_id = m.thread_id
  JOIN projection_projects AS p ON p.project_id = t.project_id
  LEFT JOIN provider_session_runtime AS r ON r.thread_id = m.thread_id
  CROSS JOIN params
  WHERE m.role = 'user'
    AND m.is_streaming = 0
    AND t.deleted_at IS NULL
    AND p.deleted_at IS NULL
    AND instr(lower(m.text), lower(params.needle)) > 0
),
ranked AS (
  SELECT
    *,
    count(*) OVER (PARTITION BY thread_id) AS hit_count,
    row_number() OVER (
      PARTITION BY thread_id
      ORDER BY match_created_at DESC, message_id DESC
    ) AS match_rank
  FROM matches
),
chosen AS (
  SELECT
    *,
    max(
      1,
      min(
        max(1, length(message_text) - 179),
        match_position - max(0, (180 - needle_length) / 2)
      )
    ) AS snippet_start
  FROM ranked
  WHERE match_rank = 1
),
display AS (
  SELECT
    CASE WHEN archived_at IS NULL THEN 'active' ELSE 'archived' END AS state,
    replace(replace(replace(COALESCE(title, ''), char(13), ' '), char(10), ' '), char(9), ' ') AS title,
    replace(replace(replace(COALESCE(workspace_root, ''), char(13), ' '), char(10), ' '), char(9), ' ') AS workspace,
    replace(replace(replace(COALESCE(match_created_at, ''), char(13), ' '), char(10), ' '), char(9), ' ') AS matched_at,
    replace(replace(replace(
      COALESCE(NULLIF(provider_instance_id, ''), NULLIF(provider_name, '')),
      char(13), ' '
    ), char(10), ' '), char(9), ' ') AS provider,
    hit_count,
    replace(replace(replace(
      CASE
        WHEN snippet_start > 1 THEN '…' ELSE ''
      END || substr(message_text, snippet_start, 180) ||
      CASE
        WHEN snippet_start + 179 < length(message_text) THEN '…' ELSE ''
      END,
      char(13), ' '
    ), char(10), ' '), char(9), ' ') AS snippet,
    replace(replace(replace(thread_id, char(13), ' '), char(10), ' '), char(9), ' ') AS t3_thread_id,
    CASE
      WHEN typeof(codex_id) = 'text' AND codex_id <> ''
      THEN replace(replace(replace(codex_id, char(13), ' '), char(10), ' '), char(9), ' ')
      ELSE NULL
    END AS codex_thread_id
  FROM chosen
),
limited AS (
  SELECT
    state,
    title,
    workspace,
    matched_at,
    provider,
    hit_count,
    snippet,
    t3_thread_id,
    codex_thread_id,
    '/' || CAST(X'$environment_hex' AS TEXT) || '/' || t3_thread_id AS route
  FROM display
  ORDER BY matched_at DESC, t3_thread_id DESC
  LIMIT $limit
)
SQL

if $json_output; then
  read -r -d '' result_query <<'SQL' || true
SELECT json_object(
  'schemaVersion', 1,
  'matches', json(COALESCE(json_group_array(json_object(
    'state', state,
    'title', title,
    'workspace', workspace,
    'matchedAt', matched_at,
    'provider', provider,
    'hitCount', hit_count,
    'snippet', snippet,
    't3ThreadId', t3_thread_id,
    'codexThreadId', codex_thread_id,
    'route', route
  )), '[]'))
)
FROM limited;
SQL
else
  read -r -d '' result_query <<'SQL' || true
SELECT
  'State: ' || state || char(10) ||
  'Title: ' || title || char(10) ||
  'Workspace: ' || workspace || char(10) ||
  'Matched: user / ' || matched_at || char(10) ||
  'Provider: ' || COALESCE(provider, '-') || char(10) ||
  'Hits: ' || hit_count || char(10) ||
  'Snippet: ' || snippet || char(10) ||
  'T3 ID: ' || t3_thread_id || char(10) ||
  'Codex ID: ' || COALESCE(codex_thread_id, '-') || char(10) ||
  'Route: ' || route || char(10) ||
  '---'
FROM limited;
SQL
fi

if ! results=$(sqlite3 -readonly "$DB_PATH" <<SQL
.bail on
.timeout 5000
PRAGMA query_only = ON;
$query_ctes
$result_query
SQL
); then
  fail 'database query failed'
fi

if $json_output; then
  printf '%s\n' "$results"
  exit 0
fi

if [[ -z $results ]]; then
  printf 'No matching T3 threads found.\n' >&2
  exit 1
fi

printf '%s\n' "$results"
