# Install as ~/.hermes/.env with mode 0600. Never commit the populated file.
SLACK_BOT_TOKEN=xoxb-redacted
SLACK_APP_TOKEN=xapp-redacted
SLACK_ALLOWED_USERS=U_REDACTED
SLACK_ALLOWED_CHANNELS=D_REDACTED
SLACK_HOME_CHANNEL=D_REDACTED

# Dedicated CLIProxyAPI key for this workflow.
SPI_CLIPROXY_API_KEY=redacted
SPI_CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1

# Intake restrictions. Activation resolves this one-to-one Hermes DM ID.
SPI_SLACK_CHANNEL_ID=D_REDACTED
SPI_SLACK_ALLOWED_USERS=U_REDACTED

# Plane API configuration. Project/state IDs are produced by the provisioner.
SPI_PLANE_BASE_URL=https://plane.cslog.com.br
SPI_PLANE_API_KEY=redacted
SPI_PLANE_WORKSPACE=cslog
SPI_PLANE_PROJECT_NAME=AGENTE
SPI_PLANE_PROJECT_ID=00000000-0000-0000-0000-000000000000
SPI_PLANE_PROJECT_IDENTIFIER=AGENTE
SPI_PLANE_STATE_ID=00000000-0000-0000-0000-000000000000

SPI_TEXT_MODELS=kimi-k3,qwen3.8-max,deepseek/deepseek-v4-pro
SPI_VISION_MODELS=kimi-k3,qwen3.8-max,gpt-5.6-terra
SPI_STATE_ROOT=/home/cslog/.local/state/slack-plane-intake
SPI_HTTP_TIMEOUT_SECONDS=60
